        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#64748b;dashed=1;fontFamily=Courier New;fontSize=11;" value="QUY ƯỚC TRIỂN KHAI&#xa;PK khóa chính | FK khóa ngoại | UQ unique | IDX index&#xa;Auth dùng JWT: không dùng personal_access_tokens của Sanctum.&#xa;Trạng thái workflow dùng VARCHAR + PHP backed enum, không dùng MySQL ENUM.&#xa;Soft delete: employees, departments, bank_accounts, contracts, documents.&#xa;Không soft delete: attendance events, payroll, audit, approvals.&#xa;FK lịch sử: RESTRICT; actor/manager nullable: SET NULL.&#xa;Bảng Laravel hạ tầng giữ riêng: sessions, cache, cache_locks, jobs, job_batches, failed_jobs.&#xa;departments.manager_id tạo FK sau employees để xử lý quan hệ vòng.&#xa;remaining_days là giá trị tính toán, không lưu cột độc lập." vertex="1">
